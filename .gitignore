# Publish an explicit product surface; local research and transcripts stay private.
/*
!/.gitignore
!/.gitattributes
!/orca-plugin.json
!/package.json
!/package-lock.json
!/tsconfig.json
!/tsconfig.core.json
!/README.md
!/REPORT.md
!/LICENSE
!/SECURITY.md
!/CHANGELOG.md
!/src/
!/test/
!/adapters/
!/scripts/
!/docs/
!/.github/
!/assets/
node_modules/
.orca/
__pycache__/
*.env
*.env.*
*.log
*.png.tmp
.DS_Store
